# ==================================================
# Aleena AI Production Environment Variables Template
# ==================================================

# Server & Runtime Environment
NODE_ENV=development
PORT=8765

# PostgreSQL Render Database Connection
DATABASE_URL=postgres://aleena_user:password@dpg-xxxxxx-a.render.com/aleena_ai_db

# Security & Authentication Secrets (NEVER expose to frontend)
JWT_SECRET=your_super_secret_production_jwt_key_here

# Frontend Application URL for CORS
FRONTEND_URL=http://localhost:3000

# Backend AI Provider Keys (Backend only)
GEMINI_API_KEY=your_google_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Frontend Public Environment Variables (Render Static Site)
NEXT_PUBLIC_API_URL=http://localhost:8765
NEXT_PUBLIC_WS_URL=ws://localhost:8765/ws
VITE_API_URL=http://localhost:8765
VITE_SOCKET_URL=ws://localhost:8765/ws
